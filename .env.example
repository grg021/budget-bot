# --- Server ---
# Domain pointed at your droplet (A record). Caddy auto-provisions SSL.
DOMAIN=budget.example.com

# --- Actual ---
# Password you set on first visit to https://$DOMAIN
ACTUAL_PASSWORD=
# Settings -> Show advanced settings -> Sync ID (after creating your budget file)
ACTUAL_SYNC_ID=
# Only if you enabled end-to-end encryption on the budget file (optional)
ACTUAL_FILE_PASSWORD=

# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs (get yours from @userinfobot)
ALLOWED_TELEGRAM_IDS=

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Locale ---
CURRENCY_SYMBOL=₱
TZ=Asia/Manila
# Account used when a message doesn't mention one
DEFAULT_ACCOUNT=Greg Cash
